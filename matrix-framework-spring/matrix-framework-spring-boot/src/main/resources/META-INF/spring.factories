#org.springframework.context.ApplicationContextInitializer=\
#  wang.liangchen.matrix.framework.springboot.startup.StartupProcessorNew

# Failure Analyzers
org.springframework.boot.diagnostics.FailureAnalyzer=\
  startup.wang.liangchen.matrix.framework.spring.boot.StartupFailureAnalyzer

# Servlet Context Initializers
# org.springframework.boot.web.servlet.ServletContextInitializer=\

# Property Source Loaders
org.springframework.boot.env.PropertySourceLoader=\
  env.wang.liangchen.matrix.framework.spring.boot.JsonPropertySourceLoader

# Config Data Location Resolvers
org.springframework.boot.context.config.ConfigDataLocationResolver=\
  config.wang.liangchen.matrix.framework.spring.boot.MatrixConfigDataLocationResolver

# Config Data Loaders
org.springframework.boot.context.config.ConfigDataLoader=\
  config.wang.liangchen.matrix.framework.spring.boot.MatrixConfigDataLoader

