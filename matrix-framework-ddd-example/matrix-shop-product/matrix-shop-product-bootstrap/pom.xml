<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>wang.liangchen.matrix.shop</groupId>
        <artifactId>matrix-shop-product</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>matrix-shop-product-bootstrap</artifactId>

    <dependencies>
        <dependency>
            <groupId>wang.liangchen.matrix.shop</groupId>
            <artifactId>matrix-shop-product-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>wang.liangchen.matrix.shop</groupId>
            <artifactId>matrix-shop-product-interface</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>wang.liangchen.matrix.shop</groupId>
            <artifactId>matrix-shop-product-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>wang.liangchen.matrix.shop</groupId>
            <artifactId>matrix-shop-product-client-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${version.spring.boot}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>