<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>wang.liangchen.matrix</groupId>
        <artifactId>matrix-framework</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>matrix-framework-ddd</artifactId>

    <dependencies>
        <!-- 领域驱动架构规则集（DddArchitectureRules）依赖：optional，不随框架传递。
             业务模块如需在测试中守护分层依赖规则，需在pom中自行声明archunit测试依赖（scope=test） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.3.0</version>
            <optional>true</optional>
        </dependency>
        <!-- 框架规则集自测（dogfooding）依赖 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                    ValueObjectFieldTypeProcessor 在本模块定义但通过 META-INF/services 注册，
                    javac 编译本模块时 ServiceLoader 会尝试加载它，但此时类尚未编译完成导致 ServiceConfigurationError。
                    -proc:none 禁用本模块编译期的注解处理；该处理器由依赖本模块的其他模块使用。
                    -->
                    <compilerArgs>
                        <arg>-proc:none</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>